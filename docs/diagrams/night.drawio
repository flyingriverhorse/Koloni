<mxCell id="tl" value="Triggers: only you make or change one" style="rounded=1;arcSize=2;fillColor=#fcfcfc;strokeColor=#d6b656;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="1160" height="360" as="geometry"/></mxCell>
<mxCell id="clock" value="By the clock&#xa;every N minutes (at least 5),&#xa;or at a time of day" style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="36" y="100" width="250" height="84" as="geometry"/></mxCell>
