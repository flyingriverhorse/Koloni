<mxCell id="nl" value="Work while you're away: the Orchestrator's jobs, for an hour or the night" style="rounded=1;arcSize=2;fillColor=#fcfcfc;strokeColor=#6c8ebf;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="446" width="1160" height="360" as="geometry"/></mxCell>
<mxCell id="plan" value="Only the Orchestrator&#xa;plans the jobs, in a&#xa;turn you started;&#xa;it does no job itself" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="36" y="490" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="card" value="While you're away card&#xa;Start / Change the list / Not now.&#xa;Up to 10 jobs; what is kept out;&#xa;stops at the limit or time you set,&#xa;if any (and within your budget)" style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="286" y="482" width="300" height="126" as="geometry"/></mxCell>
<mxCell id="jobs" value="Jobs, one at a time&#xa;each in a new chat and its&#xa;own copy; 60 minutes at&#xa;most; a failure tried again" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="616" y="482" width="260" height="126" as="geometry"/></mxCell>
<mxCell id="morning" value="When you're back: the report&#xa;Done, Waits for your word,&#xa;Could not be done, Stopped,&#xa;Not started, Kept out" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="906" y="482" width="260" height="126" as="geometry"/></mxCell>
