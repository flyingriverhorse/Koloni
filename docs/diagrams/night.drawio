<mxCell id="copy" value="Your project does not change&#xa;meanwhile: the work waits in the&#xa;copies, a job that needs your&#xa;word waits and the next goes on" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="286" y="640" width="300" height="110" as="geometry"/></mxCell>
<mxCell id="strict" value="Stricter rules: a delete, an&#xa;overwrite, sending off the&#xa;machine or a shell command&#xa;waits; kept out is refused;&#xa;no MCP tools" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="616" y="636" width="260" height="130" as="geometry"/></mxCell>
