<mxCell id="refused" value="Anything else is refused,&#xa;not asked. Its record says&#xa;It would have asked you: ...&#xa;with Allow this in the trigger" style="rounded=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="930" y="100" width="236" height="120" as="geometry"/></mxCell>
<mxCell id="never" value="Never: secret files, files&#xa;that steer later turns, outside&#xa;the project, MCP tools, a move&#xa;to a paid provider, a CLI with&#xa;its own tools, the memory core" style="rounded=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="930" y="236" width="236" height="130" as="geometry"/></mxCell>
