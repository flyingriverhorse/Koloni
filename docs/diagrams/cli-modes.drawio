<mxfile host="KOLONİ docs">
<diagram id="cli-modes" name="cli-modes">
<mxGraphModel dx="1240" dy="920" grid="1" gridSize="10" page="1" pageWidth="1240" pageHeight="920" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="backdrop" value="" style="rounded=0;fillColor=#ffffff;strokeColor=none;locked=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1240" height="920" as="geometry"/></mxCell>
<mxCell id="title" value="How CLIs are driven: the modes, KOLONİ's tools and the asks" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=24;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1180" height="36" as="geometry"/></mxCell>
<mxCell id="step" value="One run per model step&#xa;(Claude Code, Codex)&#xa;&#xa;A new CLI process for each step, in an&#xa;empty folder, its own tools off. KOLONİ&#xa;sends its tool list and the chat; the CLI&#xa;answers with text and tool calls." style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="390" height="200" as="geometry"/></mxCell>
<mxCell id="session" value="One session per agent&#xa;(Claude Code, Codex, Copilot, Qoder)&#xa;&#xa;One CLI process runs the agent's loop&#xa;for the turn, its own tools off (Codex's&#xa;patch tool stays on: KOLONİ refuses&#xa;each patch). Its one MCP server is&#xa;KOLONİ's tool bridge." style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="425" y="70" width="390" height="200" as="geometry"/></mxCell>
<mxCell id="native" value="Native&#xa;(all five)&#xa;&#xa;The CLI runs its own loop and tools in&#xa;your folder or a working copy. KOLONİ's&#xa;team tools (open an agent, ask you)&#xa;come over the tool bridge.&#xa;&#xa;agy's default: Reads with its own tools,&#xa;only reading; no writes, no commands." style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="830" y="66" width="390" height="244" as="geometry"/></mxCell>
<mxCell id="tools" value="KOLONİ's tools: the permission&#xa;check and its cards (Ready for you)" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="390" height="90" as="geometry"/></mxCell>
<mxCell id="bridge" value="KOLONİ's tool bridge (MCP): the CLI starts&#xa;it over stdio; it reaches KOLONİ's tool&#xa;server on 127.0.0.1 with a key" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="425" y="330" width="390" height="90" as="geometry"/></mxCell>
<mxCell id="e7" value="KOLONİ runs them" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step" target="tools"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="tool calls" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="session" target="bridge"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" value="team tools" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="native" target="bridge"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bridge" target="tools"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="asks" value="A native CLI asks KOLONİ before its own tools act, except where noted" style="rounded=1;arcSize=2;fillColor=#fcfcfc;strokeColor=#d79b00;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="1200" height="200" as="geometry"/></mxCell>
<mxCell id="k0" value="Claude Code&#xa;a control protocol on&#xa;stdin and stdout, with&#xa;a hook callback:&#xa;every tool" style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="34" y="510" width="226" height="140" as="geometry"/></mxCell>
<mxCell id="k1" value="Qoder&#xa;the same control&#xa;protocol: every tool&#xa;(not yet measured)" style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="272" y="510" width="226" height="140" as="geometry"/></mxCell>
<mxCell id="k2" value="Codex&#xa;app-server, JSON-RPC:&#xa;each command and&#xa;patch, but not the&#xa;commands its own&#xa;rules count as safe&#xa;or its web search" style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="510" y="510" width="226" height="140" as="geometry"/></mxCell>
<mxCell id="k3" value="Copilot&#xa;headless, JSON-RPC:&#xa;each command, write&#xa;and read" style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="748" y="510" width="226" height="140" as="geometry"/></mxCell>
<mxCell id="k4" value="agy&#xa;a hook file in its own&#xa;home runs KOLONİ's&#xa;hook: every tool. In&#xa;Reads (its default):&#xa;no hook, its reads&#xa;are not asked" style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="986" y="510" width="226" height="140" as="geometry"/></mxCell>
<mxCell id="e17" value="asks" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;entryX=0.86;entryY=0;" edge="1" parent="1" source="native" target="asks"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e18" value="the same check&#xa;and cards" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.083;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="asks" target="tools"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="450"/></Array></mxGeometry></mxCell>
<mxCell id="homes" value="Sign-in&#xa;Claude Code, Codex: My own (your home&#xa;folder) or Its own for KOLONİ, a folder&#xa;under runtime/cli-homes (CLAUDE_CONFIG_DIR,&#xa;CODEX_HOME). Copilot: an empty home each&#xa;run, your gh or a token. agy: a new home&#xa;each run. Qoder: your own sign-in." style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="390" height="160" as="geometry"/></mxCell>
<mxCell id="resume" value="Going on from the last turn&#xa;Only Claude Code, Native, with Its own for&#xa;KOLONİ, resumes its session: it is sent only&#xa;what is new, while its home, model, setup&#xa;and permission level stay the same. Every&#xa;other CLI starts each turn anew." style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="425" y="700" width="390" height="160" as="geometry"/></mxCell>
<mxCell id="compact" value="Compaction&#xa;A resumed Claude Code session compacts&#xa;itself. Other session and native leads:&#xa;KOLONİ compacts past Summarise a long&#xa;context at (%), or on Compact now. A&#xa;run per model step is trimmed instead." style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="830" y="700" width="390" height="160" as="geometry"/></mxCell>
<mxCell id="footer" value="From: app/providers.py, app/model_cli.py, app/model_session.py, app/model_native.py, app/model_agy.py, app/agy_hook.py, app/mcp_bridge.py, app/limits.py,&#xa;app/agent/native_mixin.py, app/agent/approvals_mixin.py, app/agent/context_mixin.py (7 Nov 2026)" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#555555;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="874" width="1180" height="40" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>
</mxfile>
