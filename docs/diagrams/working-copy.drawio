<mxfile host="KOLONİ docs">
<diagram id="working-copy" name="working-copy">
<mxGraphModel dx="1240" dy="1200" grid="1" gridSize="10" page="1" pageWidth="1240" pageHeight="1200" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="backdrop" value="" style="rounded=0;fillColor=#ffffff;strokeColor=none;locked=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1240" height="1200" as="geometry"/></mxCell>
<mxCell id="title" value="A working copy's life: from the copy to your project" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=24;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1180" height="36" as="geometry"/></mxCell>
<mxCell id="make" value="1  An agent's first change or&#xa;command: KOLONİ makes&#xa;its working copy" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="280" height="100" as="geometry"/></mxCell>
<mxCell id="plain" value="A copy of the files, git or not&#xa;.git and caches left out; node_modules&#xa;and .venv linked; the starting state&#xa;is kept to merge against" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="70" width="330" height="120" as="geometry"/></mxCell>
<mxCell id="branch" value="Or, on a branch: a git&#xa;worktree on its own&#xa;branch (below)" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="710" y="70" width="250" height="120" as="geometry"/></mxCell>
<mxCell id="big" value="Too big (over 20,000&#xa;files or 500 MB):&#xa;the agent works in&#xa;the project itself" style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="220" height="120" as="geometry"/></mxCell>
<mxCell id="where" value="Where: runtime/copies; when that sits inside a git checkout or beside agent rules (as in&#xa;KOLONİ's own folder), the user's data folder: %LOCALAPPDATA%\KOLONI\copies on Windows, else&#xa;~/.local/share/KOLONI/copies ($XDG_DATA_HOME if set). Your project does not change until taken in." style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#333333;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="340" y="194" width="880" height="66" as="geometry"/></mxCell>
<mxCell id="work" value="2  The agent works in its copy:&#xa;edits, commands, tests" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="done" value="3  It finishes: a card in Ready&#xa;for you, Take in ...'s work?" style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="260" width="330" height="110" as="geometry"/></mxCell>
<mxCell id="test" value="Run the test: the project's&#xa;Test before adding command,&#xa;run in the copy" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="710" y="265" width="250" height="100" as="geometry"/></mxCell>
<mxCell id="auto" value="Auto-edit files, Full auto:&#xa;no card when it finished,&#xa;nothing clashes and the&#xa;test passed" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="260" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="e11" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="make" target="plain"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e12" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="make" target="work"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e13" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="work" target="done"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e14" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="done" target="test"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e15" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="test" target="auto"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="apply" value="4  Take in&#xa;file by file, a three-way merge&#xa;with your folder; nothing is&#xa;committed by itself" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="300" height="120" as="geometry"/></mxCell>
<mxCell id="discard" value="Discard&#xa;nothing comes in;&#xa;the copy is removed" style="rounded=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="430" width="260" height="120" as="geometry"/></mxCell>
<mxCell id="clash" value="Changed on both sides: a line&#xa;merge; if lines clash, Nothing is&#xa;chosen for you: pick a side per&#xa;file, or Let an agent resolve&#xa;the conflicts" style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="990" y="420" width="230" height="140" as="geometry"/></mxCell>
<mxCell id="e20" value="Take in" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="done" target="apply"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e22" value="Discard" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;entryX=0.4;entryY=0;" edge="1" parent="1" source="done" target="discard"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e23" value="a clash" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="apply" target="clash"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="580"/><mxPoint x="1105" y="580"/></Array></mxGeometry></mxCell>
<mxCell id="commit" value="Save each sub-agent's work as a&#xa;git commit (Settings › This project&#xa;› Checks and git): the card offers&#xa;Commit once it is in; always your&#xa;click, nothing pushed" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="300" height="130" as="geometry"/></mxCell>
<mxCell id="gone" value="Removed: a copy after Take in or&#xa;Discard, or a copy with no changes;&#xa;a branch after merging, unless&#xa;Keep this branch after merging" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="360" y="620" width="300" height="110" as="geometry"/></mxCell>
<mxCell id="kept" value="Kept for your Take in: a copy with changes whose agent stopped&#xa;part-way, or when you pressed Stop or Stop everything.&#xa;Kept, nothing taken in: after an error or a restart (found again at the next&#xa;start), an away job's copy, a failed or clashing check with nobody watching.&#xa;At start, every copy that is not kept is cleared." style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="610" width="520" height="130" as="geometry"/></mxCell>
<mxCell id="e27" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="apply" target="commit"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="lane" value="On a branch: an agent the Orchestrator puts on one (or a To-do task's turn)" style="rounded=1;arcSize=2;fillColor=#fcfcfc;strokeColor=#6c8ebf;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="770" width="1200" height="364" as="geometry"/></mxCell>
<mxCell id="b1" value="A branch for the agent:&#xa;a git worktree on&#xa;koloni/&lt;name&gt;, made from&#xa;where your branch is now" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="36" y="820" width="250" height="130" as="geometry"/></mxCell>
<mxCell id="b2" value="The agent works&#xa;in its worktree:&#xa;edits, commands,&#xa;tests" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="326" y="820" width="190" height="130" as="geometry"/></mxCell>
<mxCell id="b3" value="It stops (by itself, Stop or&#xa;Stop everything), or it ends&#xa;with nobody watching: its&#xa;work is committed on the&#xa;branch, the branch kept" style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="576" y="820" width="270" height="130" as="geometry"/></mxCell>
<mxCell id="b4" value="Told to go on: the same&#xa;branch opened again; or a copy,&#xa;saying why: the branch was&#xa;merged or sent as a pull&#xa;request, deleted, another&#xa;branch has its name now,&#xa;or it is checked out elsewhere" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="906" y="806" width="298" height="158" as="geometry"/></mxCell>
<mxCell id="b5" value="It finishes: a card (at Full auto it goes on&#xa;by itself where the test passes). The merge is&#xa;held to where the branch was made from:&#xa;if the project moved to another branch, or&#xa;that commit is gone, it waits for you, at&#xa;Full auto too" style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="36" y="990" width="370" height="130" as="geometry"/></mxCell>
<mxCell id="b6" value="Merge: one squash commit on&#xa;your branch, then the branch is&#xa;deleted, unless you keep it.&#xa;Open pull request: pushed, never&#xa;merged by KOLONİ. Discard&#xa;deletes the branch." style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="446" y="990" width="300" height="130" as="geometry"/></mxCell>
<mxCell id="b7" value="A secret given this turn on the branch:&#xa;never merged or kept. Stopped, or&#xa;nobody watching: the branch is deleted.&#xa;On the card: take it off the branch, or&#xa;Discard" style="rounded=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="786" y="990" width="418" height="130" as="geometry"/></mxCell>
<mxCell id="e30" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e31" value="stops" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e32" value="go on" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e33" value="finishes" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="b2" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e34" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="footer" value="From: app/copies.py, app/git.py, app/agent/merge.py, app/agent/__init__.py, app/agent/spawn_mixin.py, app/changes.py,&#xa;frontend/src/changes/MergeCard.tsx, frontend/src/shell/sections/Checks.tsx (7 Nov 2026)" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#555555;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="1150" width="1180" height="40" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>
</mxfile>
