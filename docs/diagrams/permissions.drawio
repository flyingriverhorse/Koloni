<mxCell id="origin" value="Who answers a card: only your page.&#xa;Every /api call carries the page key&#xa;(X-KOLONI-Key); what only you may do&#xa;also needs the page's own Origin. An&#xa;agent's command has neither." style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="718" width="420" height="120" as="geometry"/></mxCell>
<mxCell id="harm" value="The harm check at Full auto is a&#xa;courtesy for honest commands, not a&#xa;wall: a command written to hide what&#xa;it does is not seen. For a wall, run&#xa;commands in Docker." style="rounded=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="480" y="718" width="400" height="120" as="geometry"/></mxCell>
<mxCell id="unwatched" value="A trigger's turn&#xa;nobody watches: its own&#xa;permissions decide;&#xa;the rest is refused,&#xa;not asked" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="578" width="170" height="260" as="geometry"/></mxCell>
