<mxCell id="backdrop" value="" style="rounded=0;fillColor=#ffffff;strokeColor=none;locked=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1240" height="930" as="geometry"/></mxCell>
<mxCell id="title" value="The recipe engine: how a team's recipe runs, loops and ends" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=24;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1180" height="36" as="geometry"/></mxCell>
<mxCell id="start" value="Start&#xa;one working copy&#xa;for the team" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="170" height="90" as="geometry"/></mxCell>
<mxCell id="step" value="A step&#xa;Who: a role (at most 1 to 5),&#xa;the team's experts, the&#xa;Orchestrator picks, a team's&#xa;stages, or Candidates" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="230" y="70" width="260" height="130" as="geometry"/></mxCell>
<mxCell id="group" value="All at once" style="rounded=1;arcSize=2;fillColor=#fcfcfc;strokeColor=#6c8ebf;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="530" y="60" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="g1" value="a step" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="545" y="96" width="120" height="46" as="geometry"/></mxCell>
<mxCell id="g2" value="a step" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="685" y="96" width="120" height="46" as="geometry"/></mxCell>
<mxCell id="gw" value="waits for all branches,&#xa;or the first one done" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#333333;fontSize=14;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="545" y="150" width="270" height="46" as="geometry"/></mxCell>
<mxCell id="review" value="A review step&#xa;Done when: no finding&#xa;is left (a review)" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="860" y="80" width="180" height="110" as="geometry"/></mxCell>
<mxCell id="fix" value="Only if the step&#xa;before found a&#xa;problem: a fixer" style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="1070" y="80" width="150" height="110" as="geometry"/></mxCell>
<mxCell id="e10" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="start" target="step"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e11" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="step" target="group"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e12" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="group" target="review"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e13" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="review" target="fix"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e14" value="Loop back: at most&#xa;1 to 5 rounds" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="fix" target="step"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1145" y="250"/><mxPoint x="360" y="250"/></Array></mxGeometry></mxCell>
<mxCell id="find" value="Findings in a review's report" style="rounded=1;arcSize=2;fillColor=#fcfcfc;strokeColor=#d79b00;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="590" height="210" as="geometry"/></mxCell>
<mxCell id="block" value="Blocking (unmarked, security,&#xa;a failing test): the work goes&#xa;back along the loop. No rounds&#xa;left: it stops before the next&#xa;step, findings are left" style="rounded=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="34" y="340" width="280" height="150" as="geometry"/></mxCell>
<mxCell id="sugg" value="A suggestion: no work&#xa;goes back; it is left&#xa;for you on the card" style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="334" y="340" width="260" height="150" as="geometry"/></mxCell>
<mxCell id="cand" value="Candidates and Evolve" style="rounded=1;arcSize=2;fillColor=#fcfcfc;strokeColor=#9673a6;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="630" y="300" width="590" height="210" as="geometry"/></mxCell>
<mxCell id="c1" value="2 to 5 candidates, the&#xa;same job, each in its own&#xa;copy; their models: Auto,&#xa;Same model or I pick each" style="rounded=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="644" y="340" width="270" height="150" as="geometry"/></mxCell>
<mxCell id="c2" value="The Measure command scores&#xa;each (0 to 100); a card picks&#xa;(Full auto: the best). It is kept&#xa;only if it beats the best kept;&#xa;below the Target, a loop tries&#xa;again (Evolve: 3 Coders)" style="rounded=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="930" y="336" width="276" height="158" as="geometry"/></mxCell>
<mxCell id="e21" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ask" value="Asking you on the way" style="rounded=1;arcSize=2;fillColor=#fcfcfc;strokeColor=#666666;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="1200" height="140" as="geometry"/></mxCell>
<mxCell id="askme" value="Ask me to approve its work before it goes on: a card with&#xa;Go on, Ask for changes (the same step again, with your&#xa;words) or Stop" style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="34" y="576" width="580" height="90" as="geometry"/></mxCell>
<mxCell id="fails" value="If it fails: ask me (Try again, Skip, Stop) or stop.&#xa;A step with nobody to fill it is passed over." style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="634" y="576" width="572" height="90" as="geometry"/></mxCell>
<mxCell id="end" value="An end&#xa;Ask me, then in: the card.&#xa;Tell me what was found:&#xa;the card only if files&#xa;changed or a fixer worked" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="710" width="260" height="130" as="geometry"/></mxCell>
<mxCell id="fork" value="A step with more&#xa;than one arrow out&#xa;runs every path;&#xa;where they meet&#xa;waits for all." style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#333333;fontSize=14;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="196" width="200" height="96" as="geometry"/></mxCell>
<mxCell id="ready" value="Ready for you&#xa;once every team is at its end:&#xa;Take in / Fix the findings /&#xa;Ask for changes" style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="710" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="back" value="Ask for changes: back to the last loop's&#xa;first step (or the first step), rounds&#xa;count again, your words go to the agents.&#xa;Fix the findings: it takes the work in,&#xa;then a Coder fixes what is left." style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="710" width="520" height="130" as="geometry"/></mxCell>
<mxCell id="e29" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="end" target="ready"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e30" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ready" target="back"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="auto" value="At Full auto the work is taken in without the card, unless a team failed or a check was skipped." style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#333333;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="846" width="1190" height="24" as="geometry"/></mxCell>
<mxCell id="footer" value="From: app/recipe_run.py, app/recipes.py, app/evolve.py, app/agent/spawn_mixin.py, app/agent/summary.py, app/agent/__init__.py (6 Nov 2026)" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#555555;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="884" width="1180" height="40" as="geometry"/></mxCell>
</root>
