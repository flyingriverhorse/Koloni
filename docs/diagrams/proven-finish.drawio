<mxCell id="title" value="Proven finish: what KOLONİ checks at a turn's end" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=24;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1180" height="36" as="geometry"/></mxCell>
<mxCell id="lead" value="Before the Orchestrator's answer ends a turn that changed the project, each check runs in this order;&#xa;the first that sends work back ends the pass, and the next answer is checked again." style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#333333;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1180" height="44" as="geometry"/></mxCell>
<mxCell id="gate" value="The end gate" style="rounded=1;arcSize=2;fillColor=#fcfcfc;strokeColor=#6c8ebf;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="1200" height="300" as="geometry"/></mxCell>
<mxCell id="answer" value="The Orchestrator's&#xa;answer" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="36" y="150" width="150" height="90" as="geometry"/></mxCell>
<mxCell id="related" value="Tests&#xa;related tests first,&#xa;while you wait" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="210" y="150" width="170" height="90" as="geometry"/></mxCell>
<mxCell id="suite" value="The whole suite&#xa;goes on after the&#xa;answer (its result&#xa;later, on the node)" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="210" y="270" width="170" height="110" as="geometry"/></mxCell>
<mxCell id="kinds" value="Documents, diagrams,&#xa;data, slides&#xa;links, parses,&#xa;rows, empty slides" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="404" y="150" width="190" height="110" as="geometry"/></mxCell>
<mxCell id="review" value="Review&#xa;a big or security-&#xa;touching change:&#xa;Reviewer (+ Security&#xa;reviewer)" style="rounded=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="618" y="150" width="180" height="120" as="geometry"/></mxCell>
<mxCell id="verdict" value="MERGE: it stands&#xa;HOLD: its blocking&#xa;findings go back" style="rounded=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="618" y="290" width="180" height="90" as="geometry"/></mxCell>
<mxCell id="ask" value="A test for the&#xa;change&#xa;code changed and&#xa;no test: asked once" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="822" y="150" width="170" height="110" as="geometry"/></mxCell>
