<mxCell id="e7" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ask" target="checked"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="before" value="A failing test runs&#xa;once more alone (it&#xa;passes: flaky) and on&#xa;the old code (it fails&#xa;there too: failing&#xa;before) - neither is&#xa;sent back" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#333333;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="410" y="276" width="190" height="126" as="geometry"/></mxCell>
<mxCell id="fail" value="When a check fails" style="rounded=1;arcSize=2;fillColor=#fcfcfc;strokeColor=#b85450;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="1200" height="190" as="geometry"/></mxCell>
<mxCell id="round" value="A fix round&#xa;the failures go back to the&#xa;Orchestrator - at most&#xa;Fix rounds times (1 to 5)" style="rounded=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="36" y="470" width="260" height="120" as="geometry"/></mxCell>
<mxCell id="strong" value="Then a stronger model&#xa;first: is the failure real, did&#xa;this work break it; then a&#xa;diagnosis before a patch" style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="326" y="470" width="280" height="120" as="geometry"/></mxCell>
<mxCell id="still" value="Still failing after the rounds:&#xa;you decide (Fix it);&#xa;the work is not taken in" style="rounded=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="636" y="470" width="270" height="120" as="geometry"/></mxCell>
<mxCell id="recipe" value="In a recipe: its own test-and-fix&#xa;loop counts - rounds never stack" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="936" y="470" width="270" height="120" as="geometry"/></mxCell>
