<mxCell id="a6" value="Merge&#xa;a copy into the&#xa;project; recovery&#xa;at start-up" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="928" y="626" width="138" height="120" as="geometry"/></mxCell>
<mxCell id="a7" value="Away&#xa;away jobs'&#xa;rules for a turn" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="1077" y="626" width="138" height="120" as="geometry"/></mxCell>
<mxCell id="also" value="Also: Attachments (your files), Browser (the agent's own browser), Skills, Cards (card helpers). The turn ends when the&#xa;Orchestrator asks no more tools: its copies come in, or wait in Ready for you, and a queued message starts the next turn." style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#333333;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="776" width="1190" height="50" as="geometry"/></mxCell>
