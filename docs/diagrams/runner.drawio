<mxCell id="title" value="Inside the agent runner: one turn, its steps, and the parts around them" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=24;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1180" height="36" as="geometry"/></mxCell>
<mxCell id="start" value="A turn starts&#xa;one task per turn,&#xa;the Orchestrator first" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="230" height="90" as="geometry"/></mxCell>
<mxCell id="tiers" value="Tiers&#xa;which provider and&#xa;model for this agent" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="300" y="80" width="230" height="90" as="geometry"/></mxCell>
<mxCell id="loop" value="Loop: step after step, until the model asks no tool or a limit stops it.&#xa;Step mode: KOLONİ runs each step (below).&#xa;Session: a CLI keeps the loop and asks for KOLONİ's tools.&#xa;Native: a CLI uses its own tools; Approvals answers its asks." style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="70" width="650" height="110" as="geometry"/></mxCell>
<mxCell id="ctx" value="Context&#xa;the history sent with&#xa;this step: messages,&#xa;notes, tool results" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="230" width="260" height="110" as="geometry"/></mxCell>
<mxCell id="comp" value="Compaction&#xa;past Summarise a long&#xa;context at: the older&#xa;part summed (Compact now)" style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="230" width="260" height="110" as="geometry"/></mxCell>
