<mxCell id="cut_bottom" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="455" y="278" width="1" height="1" as="geometry"/></mxCell>
<mxCell id="cut" value="" style="endArrow=none;strokeColor=#b85450;strokeWidth=2.5;dashed=1;fontFamily=Helvetica;fontSize=15;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cut_top" target="cut_bottom"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="t3" value="Turn 3: Write the README&#xa;starts topic B" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="480" y="100" width="190" height="76" as="geometry"/></mxCell>
<mxCell id="t4" value="Turn 4: and add a FAQ&#xa;goes on with topic B" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="690" y="100" width="190" height="76" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t3" target="t4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="sees" value="Turn 4's Orchestrator&#xa;is sent turn 3 and its own&#xa;message; of topic A, only&#xa;its name. It can go on with&#xa;an agent of turn 3 - never&#xa;one of turn 1 or 2." style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="100" width="260" height="166" as="geometry"/></mxCell>
<mxCell id="e3" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="t4" target="sees"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="cc_a" value="Claude Code, Native, on its own sign-in:&#xa;turn 2 resumes turn 1's session" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="196" width="400" height="70" as="geometry"/></mxCell>
<mxCell id="cc_b" value="turn 3 starts a new session;&#xa;turn 4 resumes turn 3's" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="480" y="196" width="400" height="70" as="geometry"/></mxCell>
<mxCell id="l_head" value="Where the turns before are kept, by kind of model" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=17;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="1140" height="24" as="geometry"/></mxCell>
<mxCell id="l1" value="An API model&#xa;Anthropic, OpenAI-compatible,&#xa;your own model server" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="336" width="300" height="110" as="geometry"/></mxCell>
<mxCell id="l1a" value="The chat lives in KOLONİ's database.&#xa;Each turn KOLONİ sends the&#xa;topic's history." style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="360" y="336" width="390" height="110" as="geometry"/></mxCell>
<mxCell id="l1b" value="KOLONİ compacts it: past Summarise a&#xa;long context at (%) - 75 by default -&#xa;of its window, the older part&#xa;is summarised." style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="780" y="336" width="390" height="110" as="geometry"/></mxCell>
<mxCell id="l2" value="Every other CLI&#xa;Codex, Copilot, Qoder, agy, and&#xa;Claude Code on your own&#xa;sign-in or not run Native" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="466" width="300" height="110" as="geometry"/></mxCell>
<mxCell id="l2a" value="Started anew each turn and sent&#xa;the topic's history again:&#xa;no session of its own goes on." style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="360" y="466" width="390" height="110" as="geometry"/></mxCell>
<mxCell id="l2b" value="KOLONİ compacts it, as for an API&#xa;model (the role's window, else the&#xa;catalogue's). One run per model step:&#xa;each step is sent a trimmed history." style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="780" y="466" width="390" height="110" as="geometry"/></mxCell>
<mxCell id="l3" value="Claude Code, Native, with&#xa;Sign-in: Its own for KOLONİ" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="596" width="300" height="110" as="geometry"/></mxCell>
<mxCell id="l3a" value="Its session is kept in KOLONİ's folder&#xa;(runtime/cli-homes/&lt;provider id&gt;);&#xa;the topic's next turn resumes it,&#xa;sent only what is new." style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="360" y="596" width="390" height="110" as="geometry"/></mxCell>
<mxCell id="l3b" value="It compacts its session itself. A new&#xa;topic - or another model, folder,&#xa;permission level or setup - starts&#xa;a new session." style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="780" y="596" width="390" height="110" as="geometry"/></mxCell>
<mxCell id="e11" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="l1" target="l1a"><mxGeometry relative="1" as="geometry"/></mxCell>
