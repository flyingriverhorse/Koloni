<mxCell id="title" value="Who remembers what: a chat's topics, and where the turns before are kept" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=24;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1140" height="36" as="geometry"/></mxCell>
<mxCell id="s_head" value="One chat, two topics" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=17;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="66" width="400" height="24" as="geometry"/></mxCell>
<mxCell id="cut_label" value="New topic: the line between them" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#b85450;fontSize=15;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="466" y="68" width="300" height="22" as="geometry"/></mxCell>
<mxCell id="t1" value="Turn 1: Fix the login bug&#xa;starts topic A" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="190" height="76" as="geometry"/></mxCell>
<mxCell id="t2" value="Turn 2: and the logout&#xa;goes on with topic A" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="240" y="100" width="190" height="76" as="geometry"/></mxCell>
