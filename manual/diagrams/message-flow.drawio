<mxfile host="KOLONİ docs">
<diagram id="message-flow" name="message-flow">
<mxGraphModel dx="1240" dy="800" grid="1" gridSize="10" page="1" pageWidth="1240" pageHeight="800" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="backdrop" value="" style="rounded=0;fillColor=#ffffff;strokeColor=none;locked=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1240" height="800" as="geometry"/></mxCell>
<mxCell id="title" value="A message's journey: from Send to the chat and the canvas" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=24;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1180" height="36" as="geometry"/></mxCell>
<mxCell id="page" value="Your browser" style="rounded=1;arcSize=2;fillColor=#fcfcfc;strokeColor=#82b366;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=17;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="66" width="250" height="650" as="geometry"/></mxCell>
<mxCell id="srv" value="KOLONİ on 127.0.0.1" style="rounded=1;arcSize=2;fillColor=#fcfcfc;strokeColor=#6c8ebf;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=17;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="290" y="66" width="930" height="490" as="geometry"/></mxCell>
<mxCell id="send" value="1  You type and&#xa;press Send&#xa;(Queue, while&#xa;agents work)" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="210" height="110" as="geometry"/></mxCell>
<mxCell id="post" value="2  REST: POST the&#xa;message to the chat&#xa;(with the page key)" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="310" y="110" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="rec" value="3  It records the turn&#xa;and your message,&#xa;then starts the run" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="610" y="110" width="270" height="100" as="geometry"/></mxCell>
<mxCell id="lead" value="4  Agent runner: the&#xa;Orchestrator takes&#xa;a step" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="920" y="110" width="280" height="100" as="geometry"/></mxCell>
<mxCell id="model" value="5  A model step: an API,&#xa;a model server here or a&#xa;CLI; the answer streams in" style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="920" y="260" width="280" height="100" as="geometry"/></mxCell>
<mxCell id="tool" value="6  It asks for a tool:&#xa;read, write, run a command,&#xa;search the web, open an agent" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="610" y="260" width="270" height="100" as="geometry"/></mxCell>
<mxCell id="check" value="7  Permission check:&#xa;your permission level,&#xa;a working copy or&#xa;the project itself" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="310" y="255" width="260" height="110" as="geometry"/></mxCell>
<mxCell id="card" value="8  Needs you: a card in&#xa;Ready for you.&#xa;The run waits here." style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="420" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="answer" value="9  You answer:&#xa;Approve / Reject,&#xa;Run once, an answer;&#xa;REST: POST it" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="210" height="110" as="geometry"/></mxCell>
<mxCell id="runs" value="10  The tool runs (or is&#xa;refused); the result is&#xa;recorded and the next&#xa;step starts" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="610" y="410" width="270" height="120" as="geometry"/></mxCell>
<mxCell id="done" value="11  No tool asked:&#xa;the answer is complete&#xa;and the turn ends" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="920" y="420" width="280" height="100" as="geometry"/></mxCell>
<mxCell id="live" value="Live updates" style="rounded=1;arcSize=2;fillColor=#fcfcfc;strokeColor=#666666;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=17;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="290" y="576" width="930" height="140" as="geometry"/></mxCell>
<mxCell id="ev" value="Every step is saved and sent as an event:&#xa;the turn, a message, a tool call, a file change, a card" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="616" width="560" height="80" as="geometry"/></mxCell>
<mxCell id="sse" value="Live stream (SSE),&#xa;one per open chat" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="616" width="260" height="80" as="geometry"/></mxCell>
<mxCell id="draw" value="12  The page updates&#xa;the chat and draws&#xa;the canvas" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="210" height="100" as="geometry"/></mxCell>
