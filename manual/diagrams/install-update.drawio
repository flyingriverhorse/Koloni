<mxCell id="backdrop" value="" style="rounded=0;fillColor=#ffffff;strokeColor=none;locked=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1240" height="860" as="geometry"/></mxCell>
<mxCell id="title" value="Install, update and backup: what is where, and what each covers" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=24;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1180" height="36" as="geometry"/></mxCell>
<mxCell id="checkout" value="KOLONİ's folder (the git checkout)" style="rounded=1;arcSize=2;fillColor=#fcfcfc;strokeColor=#6c8ebf;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="66" width="600" height="330" as="geometry"/></mxCell>
<mxCell id="code" value="app/, frontend/, scripts/, docs/&#xa;the code, from git" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="106" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="venv" value=".venv&#xa;the Python packages" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="106" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="dist" value="frontend/dist&#xa;the built page" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="site" value="runtime/site&#xa;this guide, built" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="200" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="data" value="runtime/data/koloni.db: chats, agents, settings, keys&#xa;runtime/data/backups: the last five copies&#xa;runtime/: attachments, skills, logs, cli-homes, copies" style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="294" width="560" height="86" as="geometry"/></mxCell>
<mxCell id="else" value="Elsewhere" style="rounded=1;arcSize=2;fillColor=#fcfcfc;strokeColor=#666666;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="640" y="66" width="580" height="330" as="geometry"/></mxCell>
<mxCell id="proj" value="Your project folders&#xa;and their .koloni/&#xa;(recipes, knowledge)" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="106" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="copies" value="Working copies, when runtime&#xa;sits in a checkout: on Windows&#xa;%LOCALAPPDATA%\KOLONI\copies,&#xa;else ~/.local/share/KOLONI/copies&#xa;($XDG_DATA_HOME if set)" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="940" y="100" width="270" height="116" as="geometry"/></mxCell>
<mxCell id="homes" value="The CLIs' own sign-ins:&#xa;your home folder (My own),&#xa;or runtime/cli-homes&#xa;(Its own for KOLONİ)" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="226" width="260" height="110" as="geometry"/></mxCell>
<mxCell id="dbase" value="KOLONI_RUNTIME_ROOT&#xa;moves runtime/ elsewhere;&#xa;the guide stays in&#xa;the checkout" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="940" y="226" width="260" height="110" as="geometry"/></mxCell>
<mxCell id="upd" value="Update: scripts/update.ps1 or update.sh, with KOLONİ stopped" style="rounded=1;arcSize=2;fillColor=#fcfcfc;strokeColor=#d79b00;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="1200" height="200" as="geometry"/></mxCell>
<mxCell id="u0" value="Refuses: not a git&#xa;checkout, changes in&#xa;KOLONİ's files, or&#xa;something on its port" style="rounded=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="34" y="460" width="158" height="130" as="geometry"/></mxCell>
<mxCell id="u1" value="1  Backs up the&#xa;database to&#xa;runtime/data/backups" style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="204" y="460" width="158" height="130" as="geometry"/></mxCell>
<mxCell id="e16" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="u0" target="u1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="u2" value="2  git pull&#xa;--ff-only" style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="374" y="460" width="158" height="130" as="geometry"/></mxCell>
<mxCell id="e18" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="u1" target="u2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="u3" value="3  Python packages&#xa;(uv pip sync, then&#xa;KOLONİ itself)" style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="544" y="460" width="158" height="130" as="geometry"/></mxCell>
<mxCell id="e20" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="u2" target="u3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="u4" value="4  The page's&#xa;packages, then&#xa;builds the page" style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="714" y="460" width="158" height="130" as="geometry"/></mxCell>
<mxCell id="e22" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="u3" target="u4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="u5" value="5  Rebuilds this&#xa;guide, where&#xa;Zensical is installed" style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="884" y="460" width="158" height="130" as="geometry"/></mxCell>
<mxCell id="e24" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="u4" target="u5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="u6" value="Restart KOLONİ:&#xa;the database is&#xa;migrated as it&#xa;starts" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="1054" y="460" width="158" height="130" as="geometry"/></mxCell>
<mxCell id="e26" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="u5" target="u6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="stops" value="It stops at the first step that fails: nothing after it runs, except the guide's rebuild, which only warns. -DryRun (or --dry-run) only prints the steps." style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#333333;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="626" width="1190" height="24" as="geometry"/></mxCell>
<mxCell id="export" value="Export everything (Settings, The app, Your data): one .zip:&#xa;chats, agents, providers, memory, triggers, skills and&#xa;attachments. API keys only with Include API keys and secrets.&#xa;Not in it: project folders, working copies, logs,&#xa;the CLIs' own sign-ins." style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="670" width="590" height="140" as="geometry"/></mxCell>
<mxCell id="restore" value="Restore from a file: nothing changes until KOLONİ&#xa;starts again; then the file's data comes in and&#xa;yours is set aside in runtime/before-restore.&#xa;Refused while a turn runs or a working copy&#xa;holds changes. Triggers wait for Resume." style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="630" y="670" width="590" height="140" as="geometry"/></mxCell>
<mxCell id="footer" value="From: scripts/update.ps1, scripts/update.sh, app/backup.py, app/config.py, app/copies.py, app/limits.py, app/db/session.py, zensical.toml (6 Nov 2026)" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#555555;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="814" width="1180" height="40" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>
</mxfile>
