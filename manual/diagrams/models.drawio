<mxCell id="title" value="Model and tier choice: where an agent runs" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=24;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1140" height="36" as="geometry"/></mxCell>
<mxCell id="h1" value="Tried in this order" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=17;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="66" width="390" height="24" as="geometry"/></mxCell>
<mxCell id="s1" value="1. Try first: the role's models in&#xa;your order (at most 5), only where&#xa;its opener gave the job no tier" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="390" height="84" as="geometry"/></mxCell>
<mxCell id="s2" value="2. The role's own model&#xa;(Who picks it? One model)" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="234" width="390" height="66" as="geometry"/></mxCell>
<mxCell id="e5" value="none, or passed over" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s3" value="3. The first model of the role's tier: One&#xa;tier, or the Orchestrator's pick in its&#xa;range; a tier the opener gave wins over 1." style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="350" width="390" height="84" as="geometry"/></mxCell>
<mxCell id="e7" value="none, or passed over" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s4" value="4. The chat's model (As the chat;&#xa;Model for this conversation)" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="484" width="390" height="66" as="geometry"/></mxCell>
<mxCell id="e9" value="none, or passed over" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s5" value="5. The default provider&#xa;(the first one in the list)" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="600" width="390" height="66" as="geometry"/></mxCell>
<mxCell id="e11" value="none, or passed over" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="lists" value="The tier lists: Strongest,&#xa;Balanced, Fast; models in&#xa;your order. Passed over: off,&#xa;not Agents may use, past its&#xa;limit, or down. A model with&#xa;no tier is only picked by name." style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="e13" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3" target="lists"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="auto" value="Orchestrator model: automatic&#xa;a fast model judges each&#xa;message easy, normal or hard;&#xa;the Lead runs on a fast,&#xa;balanced or strongest model&#xa;(not in a trigger's turn)" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="470" y="96" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="e15" value="picks a tier" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="auto" target="lists"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="hardness" value="An agent may call a job easy&#xa;or hard: one tier down or up" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="470" y="500" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="e17" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="hardness" target="lists"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="lim" value="Limits and moves" style="rounded=1;arcSize=2;fillColor=#fcfcfc;strokeColor=#d79b00;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="810" y="66" width="370" height="676" as="geometry"/></mxCell>
<mxCell id="plan" value="A CLI plan: Step down a tier&#xa;at N % of the plan (a role on&#xa;one tier or one model is never&#xa;stepped down)" style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="826" y="104" width="338" height="96" as="geometry"/></mxCell>
<mxCell id="money" value="An API key: at most $ a day or&#xa;a month. Past it, a new message&#xa;asks first (Go on anyway / Cancel),&#xa;a tier pick moves to the next of&#xa;its tier, no sub-agent opens there" style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="826" y="214" width="338" height="116" as="geometry"/></mxCell>
<mxCell id="paid" value="A sub-agent would move to a&#xa;provider paid per token while the&#xa;chat's is not: the Open this&#xa;sub-agent? card (Open agent /&#xa;Reject). Nobody watching: not opened" style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="826" y="344" width="338" height="116" as="geometry"/></mxCell>
<mxCell id="moved" value="A sub-agent whose provider fails&#xa;before its first word (queued too&#xa;long, server down, a limit) opens&#xa;once more on the next model of its&#xa;tier; a move that costs asks first" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="826" y="474" width="338" height="116" as="geometry"/></mxCell>
<mxCell id="qoder" value="Qoder's free models queue: shown&#xa;live; after 90 s queued a sub-agent&#xa;moves on. An agent that cannot&#xa;move waits as long as Qoder queues" style="rounded=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="826" y="604" width="338" height="116" as="geometry"/></mxCell>
<mxCell id="e24" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="qoder" target="moved"><mxGeometry relative="1" as="geometry"/></mxCell>
