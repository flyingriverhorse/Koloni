<mxfile host="KOLONİ docs">
<diagram id="proven-finish" name="proven-finish">
<mxGraphModel dx="1240" dy="1070" grid="1" gridSize="10" page="1" pageWidth="1240" pageHeight="1070" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="backdrop" value="" style="rounded=0;fillColor=#ffffff;strokeColor=none;locked=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1240" height="1070" as="geometry"/></mxCell>
<mxCell id="title" value="Proven finish: what KOLONİ checks at a turn's end" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=24;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1180" height="36" as="geometry"/></mxCell>
<mxCell id="lead" value="Before the Orchestrator's answer ends a turn that changed the project, each check runs in this order;&#xa;the first that sends work back ends the pass, and the next answer is checked again." style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#333333;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1180" height="44" as="geometry"/></mxCell>
<mxCell id="gate" value="The end gate" style="rounded=1;arcSize=2;fillColor=#fcfcfc;strokeColor=#6c8ebf;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="1200" height="390" as="geometry"/></mxCell>
<mxCell id="answer" value="The Orchestrator's&#xa;answer" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="32" y="150" width="136" height="90" as="geometry"/></mxCell>
<mxCell id="related" value="Tests&#xa;related tests first,&#xa;while you wait" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="184" y="150" width="156" height="90" as="geometry"/></mxCell>
<mxCell id="suite" value="The whole suite&#xa;goes on after the&#xa;answer (its result&#xa;later, on the node)" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="184" y="270" width="156" height="110" as="geometry"/></mxCell>
<mxCell id="kinds" value="Documents, diagrams,&#xa;data, slides, config,&#xa;scripts: links, parses,&#xa;rows, empty slides;&#xa;code style and types:&#xa;the project's ruff,&#xa;eslint, tsc, mypy;&#xa;pages, ticked: 375,&#xa;768, 1280 px, console,&#xa;width, accessibility" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="356" y="150" width="172" height="196" as="geometry"/></mxCell>
<mxCell id="review" value="Review&#xa;a big or security-&#xa;touching change:&#xa;Reviewer (+ Security&#xa;reviewer); long&#xa;documents: read once&#xa;against the request" style="rounded=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="544" y="150" width="172" height="140" as="geometry"/></mxCell>
<mxCell id="verdict" value="MERGE: it stands&#xa;HOLD: its blocking&#xa;findings go back" style="rounded=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="544" y="310" width="172" height="80" as="geometry"/></mxCell>
<mxCell id="try" value="The live try&#xa;a changed tool:&#xa;its --help only;&#xa;a big screen change:&#xa;the Tester on the&#xa;preview" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="732" y="150" width="160" height="130" as="geometry"/></mxCell>
<mxCell id="ask" value="A test for the&#xa;change (ticked)&#xa;code changed and&#xa;no test: asked once" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="908" y="150" width="148" height="110" as="geometry"/></mxCell>
<mxCell id="checked" value="Checked&#xa;under the answer:&#xa;what passed,&#xa;failed, was not&#xa;checked" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1072" y="150" width="136" height="120" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="answer" target="related"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="related" target="suite"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.23;" edge="1" parent="1" source="related" target="kinds"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.36;entryX=0;entryY=0.5;" edge="1" parent="1" source="kinds" target="review"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="review" target="verdict"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="review" target="try"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="try" target="ask"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7b" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ask" target="checked"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="before" value="A failing test runs&#xa;once more alone (it&#xa;passes: flaky) and on&#xa;the old code (it fails&#xa;there too: failing&#xa;before) - neither is&#xa;sent back" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#333333;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="356" y="356" width="176" height="126" as="geometry"/></mxCell>
<mxCell id="takein" value="Before a sub-agent's work is taken in (apart from the end gate):&#xa;only the tests it wrote or changed, in its copy - each part's&#xa;test command narrowed to them. Your own command runs them; a&#xa;guess only at Full auto - else the card waits for Run the test,&#xa;and while you are away it never runs. None written: no test before." style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="732" y="310" width="476" height="116" as="geometry"/></mxCell>
<mxCell id="fail" value="When a check fails" style="rounded=1;arcSize=2;fillColor=#fcfcfc;strokeColor=#b85450;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="1200" height="200" as="geometry"/></mxCell>
<mxCell id="round" value="A fix round&#xa;the failures go back to the&#xa;Orchestrator until it passes&#xa;(while each round makes&#xa;progress, at most 20) - or&#xa;Fix rounds times (1 to 10)" style="rounded=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="36" y="556" width="230" height="146" as="geometry"/></mxCell>
<mxCell id="strong" value="Then a stronger model (the next tier)&#xa;for a failing test: it says first&#xa;what is wrong -&#xa;fix-incomplete: it goes on&#xa;test-wrong: may change the test,&#xa;in the request's words&#xa;approach-wrong: a fresh copy" style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="286" y="556" width="300" height="146" as="geometry"/></mxCell>
<mxCell id="still" value="Nothing passes - in a copy: Not taken in,&#xa;Take in anyway / Fix it (your answer);&#xa;in the project: Still failing…, Fix it.&#xa;A check by kind of work failing after&#xa;the Fix rounds: the same.&#xa;A turn that changes nothing after a&#xa;failing one: Still failing as last&#xa;checked, Fix it." style="rounded=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="606" y="556" width="300" height="146" as="geometry"/></mxCell>
<mxCell id="recipe" value="In a recipe: its own test-and-fix&#xa;loop counts - rounds never stack.&#xa;A Reviewer's hold after the&#xa;rounds: you decide (Fix it)" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="926" y="556" width="280" height="146" as="geometry"/></mxCell>
<mxCell id="e8" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="round" target="strong"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="strong" target="still"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" value="HOLD" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;entryX=0.82;entryY=0;" edge="1" parent="1" source="verdict" target="round"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="510"/><mxPoint x="225" y="510"/></Array></mxGeometry></mxCell>
<mxCell id="settings" value="Where you set each part" style="rounded=1;arcSize=2;fillColor=#fcfcfc;strokeColor=#666666;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="730" width="1200" height="250" as="geometry"/></mxCell>
<mxCell id="s1" value="After a change&#xa;Test and review / Tests only /&#xa;Nothing (This project ›&#xa;When the work is done)" style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="36" y="770" width="280" height="110" as="geometry"/></mxCell>
<mxCell id="s2" value="Test and review changes&#xa;one chat on or off&#xa;(the permission level's menu)" style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="336" y="770" width="270" height="110" as="geometry"/></mxCell>
<mxCell id="s3" value="Fix rounds (until it passes,&#xa;or 1 to 10) and&#xa;Then a stronger model&#xa;(When the work is done)" style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="626" y="770" width="280" height="110" as="geometry"/></mxCell>
<mxCell id="s4" value="Check by kind of work&#xa;which documents, diagrams,&#xa;data, slides, pages, config,&#xa;scripts and code style&#xa;are checked" style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="926" y="770" width="280" height="110" as="geometry"/></mxCell>
<mxCell id="s5" value="The test command: a part's on the project map,&#xa;Found by KOLONİ, or your CI's lines (Run these)" style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="36" y="896" width="420" height="66" as="geometry"/></mxCell>
<mxCell id="s6" value="A recipe's Checks step: follows&#xa;the project, or set for the recipe" style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="476" y="896" width="340" height="66" as="geometry"/></mxCell>
<mxCell id="s7" value="KOLONİ's test runs at once&#xa;(Settings › The app)" style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="836" y="896" width="370" height="66" as="geometry"/></mxCell>
<mxCell id="footer" value="From: app/agent/proof_mixin.py, app/proof.py, app/agent/proof_later_mixin.py, app/agent/before_mixin.py, app/agent/kinds_mixin.py, app/proof_kinds.py, app/agent/review_mixin.py,&#xa;app/agent/test_ask_mixin.py, app/agent/try_mixin.py, app/agent/coverage_mixin.py, app/agent/stronger_mixin.py, app/ci_commands.py,&#xa;app/proof_style.py (code style and types), app/browser.py (pages), app/proof_related.py (a sub-agent's own tests) (25 Nov 2026)" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#555555;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="992" width="1180" height="62" as="geometry"/></mxCell>
