<mxfile host="KOLONİ docs">
<diagram id="security" name="security">
<mxGraphModel dx="1200" dy="1120" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="1120" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="backdrop" value="" style="rounded=0;fillColor=#ffffff;strokeColor=none;locked=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="1120" as="geometry"/></mxCell>
<mxCell id="title" value="Security boundaries: what stands between agents and the rest" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=24;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1140" height="36" as="geometry"/></mxCell>
<mxCell id="machine" value="Your machine" style="rounded=1;arcSize=2;fillColor=#fcfcfc;strokeColor=#666666;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=17;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="860" height="976" as="geometry"/></mxCell>
<mxCell id="page" value="Your browser: the KOLONİ page&#xa;holds the page key (from the link&#xa;KOLONİ prints, or a one-time code)" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="330" height="90" as="geometry"/></mxCell>
<mxCell id="koloni" value="KOLONİ on 127.0.0.1 only&#xa;every /api call needs the page key&#xa;(X-KOLONI-Key); answering a card, and the&#xa;settings that guard agents, also&#xa;need the page's own Origin; no&#xa;other page may frame it" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="430" y="100" width="430" height="140" as="geometry"/></mxCell>
<mxCell id="e5" value="" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="page" target="koloni"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="own" value="KOLONİ's own folder and runtime/&#xa;code, database (keys in plain text),&#xa;logs: never opened by an agent,&#xa;even inside a project you open" style="rounded=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="330" height="110" as="geometry"/></mxCell>
<mxCell id="agents" value="What agents reach" style="rounded=1;arcSize=2;fillColor=#fcfcfc;strokeColor=#6c8ebf;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="820" height="632" as="geometry"/></mxCell>
<mxCell id="proj" value="Your project folder&#xa;read and search freely; changes as&#xa;your level says; a secret file only on&#xa;Allow once; files that steer later&#xa;turns ask at every level" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="56" y="420" width="380" height="126" as="geometry"/></mxCell>
<mxCell id="copies" value="Working copies&#xa;sub-agents and away jobs work&#xa;here, outside your folder, until&#xa;you take their work in" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="456" y="420" width="388" height="126" as="geometry"/></mxCell>
<mxCell id="cmd" value="Commands&#xa;no page key and no secret-named&#xa;variables unless you pass them; keys&#xa;in output shown as ***; Docker (if&#xa;you pick it): a fresh container, only&#xa;the folder, network off" style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="56" y="562" width="380" height="140" as="geometry"/></mxCell>
<mxCell id="cli" value="What a CLI sees&#xa;KOLONİ's tools: only those, over MCP.&#xa;Native: its own tools, most asking&#xa;KOLONİ first (not Codex's safe commands&#xa;and web search, nor agy's reads in&#xa;Reads mode: see Known limits), and&#xa;the raw output before KOLONİ masks it" style="rounded=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="456" y="562" width="388" height="140" as="geometry"/></mxCell>
<mxCell id="secrets" value="Secrets you give&#xa;an agent asks for a key by name: a&#xa;hidden card, Give / Reject; its value&#xa;goes only into that turn's commands'&#xa;environment, shown as *** in their&#xa;output; never the chat, the record or&#xa;the model; a branch holding it is&#xa;never merged or kept" style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="56" y="718" width="380" height="160" as="geometry"/></mxCell>
<mxCell id="outside" value="Outside content&#xa;web pages, search, MCP results,&#xa;Knowledge, a GitHub issue's text: framed&#xa;as data, not instructions (KOLONİ's own&#xa;tools; not a CLI's own); a forged end&#xa;marker is defused. Limit: look-alike&#xa;letters" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="456" y="718" width="388" height="160" as="geometry"/></mxCell>
<mxCell id="blocked" value="Always blocked: your home folder, a drive's root, where&#xa;secrets are kept, KOLONİ itself, the system's folders" style="rounded=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="56" y="894" width="788" height="56" as="geometry"/></mxCell>
<mxCell id="canary" value="Planted test key (canary): a command, request, browser or MCP call&#xa;that would send it out is refused, and the work stops" style="rounded=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="56" y="958" width="788" height="44" as="geometry"/></mxCell>
<mxCell id="e14" value="an agent's call to the API:&#xa;no key, refused" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;exitX=0.618;exitY=0;entryX=0.27;entryY=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="agents" target="koloni"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="out" value="Leaves the machine only when&#xa;you set it up or allow it" style="rounded=1;arcSize=2;fillColor=#fcfcfc;strokeColor=#d79b00;dashed=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="900" y="62" width="280" height="560" as="geometry"/></mxCell>
<mxCell id="o1" value="Model providers: your&#xa;messages and the work" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="916" y="130" width="248" height="56" as="geometry"/></mxCell>
<mxCell id="o2" value="Search by meaning, to the&#xa;provider you picked" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="916" y="196" width="248" height="56" as="geometry"/></mxCell>
<mxCell id="o3" value="Web searches and requests,&#xa;public addresses only" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="916" y="262" width="248" height="56" as="geometry"/></mxCell>
<mxCell id="o4" value="Notifications, catalogue,&#xa;skills, MCP package checks" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="916" y="328" width="248" height="56" as="geometry"/></mxCell>
<mxCell id="o5" value="Pull requests, plan checks,&#xa;Knowledge's pages" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="916" y="394" width="248" height="56" as="geometry"/></mxCell>
<mxCell id="o6" value="What MCP servers and&#xa;commands reach: they run&#xa;with your own rights" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="916" y="460" width="248" height="76" as="geometry"/></mxCell>
<mxCell id="never" value="Never: telemetry (none is sent),&#xa;the page key to an agent" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=15;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="650" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="limit" value="Where it ends: Full auto's harm&#xa;check is a courtesy; a script can&#xa;still read .env without Docker" style="rounded=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="736" width="280" height="86" as="geometry"/></mxCell>
<mxCell id="e40" value="framed" style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="o3" target="outside"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890" y="290"/><mxPoint x="890" y="798"/></Array></mxGeometry></mxCell>
<mxCell id="footer" value="From: app/main.py (PageKey, NoFrame), app/api/deps.py (require_own_origin), app/workspace.py (_kept_out), app/commands.py (CANARY),&#xa;app/model_cli.py (_inherited), app/mcp_bridge.py, app/raw.py, app/copies.py, app/executors/, app/web.py, app/tools.py,&#xa;frontend/src/commands/OutsideApproval.tsx (7 Nov 2026)" style="text;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#555555;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="1050" width="1140" height="60" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>
</mxfile>
