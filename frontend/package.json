    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.93.0",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "pptx-preview": {
      "uuid": "^14.0.3"
