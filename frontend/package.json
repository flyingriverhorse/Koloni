    "@xyflow/react": "^12.12.1",
    "docx-preview": "^0.4.1",
    "highlight.js": "^11.12.0",
    "mermaid": "12.3.0",
    "pptx-preview": "^1.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.187.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
