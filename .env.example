# KOLONİ's environment variables, with their defaults.
#
# KOLONİ reads these from the environment when it starts; it does not load a .env file.
# Set them in the shell that starts it:
#   PowerShell:      $env:KOLONI_PORT = "8800"; .venv/Scripts/python.exe -m app.main
#   macOS and Linux: KOLONI_PORT=8800 .venv/bin/python -m app.main
# Every line is optional. The guide explains each one: docs/reference/environment.md

# --- Where and how KOLONİ runs ---
# The port KOLONİ listens on.
# KOLONI_PORT=8790
# Where the database, working copies, backups and logs are kept (default: runtime/ in KOLONİ's
# folder). Two KOLONİs must not share one.
# KOLONI_RUNTIME_ROOT=
# The address KOLONİ listens on. Anything but 127.0.0.1, ::1 or localhost is refused at the start,
# except inside the Docker image.
# KOLONI_HOST=127.0.0.1
# A fixed page key (default: a new one each start). KOLONİ takes it out of its own environment once
# read, so its commands and agents never get it. Keep it secret; never commit a real one.
# KOLONI_PAGE_KEY=
# 0: don't open the page in the browser at the start.
# KOLONI_OPEN_BROWSER=1
# 1: also accept the live-reload page on port 5173 (development only).
# KOLONI_DEV=

# --- The first start only (after it, change providers on the Models page) ---
# The address of the "Local" provider.
# KOLONI_MODEL_BASE_URL=http://127.0.0.1:8080/v1
# Local's default model (default: the first model the server lists).
# KOLONI_MODEL_ID=
# Local's key, if its server wants one.
# KOLONI_MODEL_API_KEY=
# 0: don't add the installed CLIs (Claude Code, Qoder, Codex, agy) as providers.
# KOLONI_DETECT_CLI=1

# --- Models and agents ---
# Seconds a model may take to start answering before the run fails.
# KOLONI_MODEL_FIRST_TOKEN_SECONDS=900
# Seconds an answer may pause before the run fails.
# KOLONI_MODEL_STALL_SECONDS=120
# Characters of history an agent keeps when its model's context window is not known.
# KOLONI_CONTEXT_CHARS=240000
# Seconds a search through the project's files may take before it is given up.
# KOLONI_SEARCH_SECONDS=20

# --- Background work ---
# 0: triggers don't start by themselves.
# KOLONI_TRIGGER_CLOCK=1
# 0: never download the model catalogue at the start.
# KOLONI_CATALOGUE_REFRESH=1

# --- The local model server and MCP servers ---
# The program the Models page's Server tab starts (default: llama-server on PATH), until you
# choose another there: the full path of llama-server in a llama.cpp build's bin folder.
# KOLONI_LOCAL_SERVER=
# The program the Server tab asks for GPU memory and load.
# KOLONI_NVIDIA_SMI=nvidia-smi
# Where the MCP servers KOLONİ starts keep their files (default: KOLONI/mcp/<one folder per
# runtime> in your cache folder - %LOCALAPPDATA% on Windows).
# KOLONI_MCP_HOME=

# Not listed: variables the Docker image sets itself (KOLONI_IN_CONTAINER) and those only the tests
# use (KOLONI_BROWSER_FAKE, KOLONI_E2E_NAMES, KOLONI_GEMINI_URL). KOLONI_CANARY_KEY is made up by
# KOLONİ for agents' commands, never set by you.
